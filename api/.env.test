# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="postgresql://app:app@db:5432/app?serverVersion=17&charset=utf8"

# Dedicated, passphrase-less keypair for the test env only (config/jwt/test/),
# kept separate from the dev keys so tests never sign with them. Generated on
# demand by tests/bootstrap.php (lexik:jwt:generate-keypair --skip-if-exists)
# and gitignored like every other *.pem — a fresh clone or CI needs no setup
# step, and no key material ever lands in the repo. These protect nothing
# real, hence no passphrase.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=

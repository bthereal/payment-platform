# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="postgresql://app:app@db:5432/app?serverVersion=17&charset=utf8"

# Dedicated, committed, passphrase-less keypair for the test env only (see
# config/jwt/test/) — unlike the dev/prod keys (config/jwt/*.pem, gitignored,
# generated fresh per environment), these protect nothing real, so there's
# no reason to keep them out of git or behind a passphrase: committing them
# makes a fresh clone or CI runnable with zero setup, exactly like the test
# database bootstrap in tests/bootstrap.php.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=
